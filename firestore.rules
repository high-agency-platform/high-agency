rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Data Model (v3 — one shared season, proof submissions, streaks, workshops)
    // ===============================================================
    //
    // Collection: applications (legacy public waitlist)
    //   Create-only from the waitlist form; never readable (minor PII).
    //   Also carries the referral attribution (referralCode / referredBy) —
    //   deliberately HERE rather than on the public counter, so who referred
    //   whom is never a client-readable graph.
    //
    // Document: meta/waitlist — public counter only.
    //
    // Collection: referrals/{code} — public, PII-free waitlist referral
    //   counters. One doc per applicant: share code, public operator id, base
    //   queue position and how many people they've brought in. Readable by
    //   anyone (a ?ref= link has to resolve for a signed-out visitor); writes
    //   are shape-bounded rather than identity-bounded. See the block below.
    //   Also holds the STAFF lead-source codes (kind: 'staff'), which are
    //   Admin-SDK-only to create and otherwise behave identically.
    //
    // Collection: staffReferralCodes/{slug} — server-only mapping from a staff
    //   member to their lead-source code. Deny-all to clients.
    //
    // Collection: profiles/{uid} — the operator profile. Readable by any
    //   signed-in user (mentors and the proof wall read it). Privacy
    //   by construction: name is "First L.", age is a band, location is
    //   country + timezone. No email/phone/DOB/exact city ever.
    //   role ('operator'|'mentor') and plan ('free'|'pro') are set by
    //   admin tooling (OAuth bypasses rules) or, for mentors, by the
    //   invite-redemption Route Handler (Admin SDK — /api/mentor/redeem);
    //   clients can't grant themselves either. There is no XP: the streak
    //   fields are the only game state, and they are SERVER-WRITTEN (frozen
    //   on every client path; see app/lib/streakServer.ts).
    //
    // Collection: privateProfiles/{uid} — DOB, full name, exact city,
    //   parent email. Owner-only, both directions. Never listed.
    //
    // Collection: seasons/{id} — THE shared track: one document every
    //   mentor edits, read by every signed-in user. SERVER-WRITTEN ONLY
    //   (POST /api/season): the save is a transaction with a stale-write
    //   check, and it refuses to drop a milestone that already has proof.
    //   Subcollection:
    //     submissions/{uid}__{milestoneId} — one operator's proof for one
    //       milestone. Server-written only (POST /api/submissions, /review):
    //       whether a row is born approved depends on the milestone's
    //       verifier, which lives inside a list these rules can't index.
    //       READ is split by the row's snapshotted `verifier` (see below).
    //
    // Collection: buildLogs/{auto} — the season feed, one line a day.
    //   Server-written (POST /api/build-log) because posting is a streak
    //   action; readable by every signed-in user; author may delete own.
    //
    // PARENTAL CONSENT for these writes is enforced in the routes, not here
    //   — the rules never see them. (The squad-era consentAllows() helper is
    //   gone with the squad writes it guarded.)
    //
    // Collection: workshops — mentor-hosted sessions, readable by every
    //   signed-in user and WRITTEN ONLY BY THE SERVER (app/api/workshops/**,
    //   Admin SDK): authoring, enrolling and leaving all go through Route
    //   Handlers because each may also touch the host's Google Calendar.
    //
    // Collection: googleTokens/{uid} — a mentor's encrypted Google refresh
    //   token. Server-only, deny-all, same posture as consentTokens.
    //
    // Collection: approvedMembers/{email} — TEMPORARY founding-batch access
    //   gate. Doc id is the trimmed+lowercased email; fields are role
    //   ('operator'|'mentor'), plus optional name/addedAt/note. Server-only:
    //   no client may read or write it (same posture as consentTokens), and
    //   it is written by staff via the Firebase Console or scripts/approve.js.
    //   A profile can only be CREATED by a caller whose token email is on this
    //   list — exists() still works against a deny-all collection, which is
    //   what makes the gate enforceable here rather than only in the UI.
    //   Delete this collection, isApprovedMember() and its use in
    //   /profiles create when the founding batch ends (see app/lib/accessGate.ts).
    //
    // ===============================================================
    // Helpers
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // Rules can't loop over list elements; we bound count + rely on
    // small max sizes to cap damage (residual risk accepted for v1).
    function validStringList(value, maxItems) {
      return value is list && value.size() <= maxItems;
    }

    function isMentor() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'mentor';
    }

    // TEMPORARY — founding-batch access gate. True when the caller's verified
    // token email is on the staff-managed allowlist. `approvedMembers` denies
    // all client access, but exists() is evaluated by the rules engine itself,
    // so this works without exposing the list to anyone.
    //
    // Guarded with .get() because not every provider puts an email on the
    // token; && short-circuits before .lower() is ever reached on a null.
    function isApprovedMember() {
      return isAuthenticated() &&
        request.auth.token.get('email', '') != '' &&
        exists(/databases/$(database)/documents/approvedMembers/$(request.auth.token.email.lower()));
    }

    // ===============================================================
    // Legacy waitlist (unchanged: create-only, PII never readable)
    // ===============================================================

    match /applications/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'age', 'building', 'boldest']) &&
                       validString(request.resource.data.name, 1, 120) &&
                       validString(request.resource.data.email, 3, 254) &&
                       validString(request.resource.data.building, 0, 2000) &&
                       validString(request.resource.data.boldest, 0, 2000) &&
                       // Referral attribution. Optional so applications that
                       // predate referrals still validate; bounded to a code so
                       // this can't become a smuggling channel into the doc.
                       (!('referralCode' in request.resource.data) ||
                         request.resource.data.referralCode.matches('^[ABCDEFGHJKMNPQRSTVWXYZ23456789]{6}$')) &&
                       (!('referredBy' in request.resource.data) ||
                         request.resource.data.referredBy == '' ||
                         request.resource.data.referredBy.matches('^[ABCDEFGHJKMNPQRSTVWXYZ23456789]{6}$')) &&
                       // Optional marketing consent. The whole block is
                       // optional so every application already on record still
                       // validates — but an opt-in is a CONSENT RECORD, and a
                       // consent record without its proof is worthless. The
                       // three clauses below are one invariant:
                       //
                       //   marketingConsent == true
                       //     <=> marketingConsentAt == request.time
                       //      &  marketingConsentSource == 'waitlist'
                       //
                       // 1. If present at all, it must be a real boolean.
                       (!('marketingConsent' in request.resource.data) ||
                         request.resource.data.marketingConsent is bool) &&
                       // 2. An opt-in MUST carry both proofs. The timestamp is
                       //    compared to request.time — the value a
                       //    serverTimestamp() sentinel resolves to — so a
                       //    client cannot backdate its own consent, and the
                       //    source must be exactly the one this form writes.
                       //    ('waitlist' is spelled out because rules cannot
                       //    import; MARKETING_CONSENT_SOURCE in
                       //    app/lib/marketingConsent.ts is the same string and
                       //    tests/referral.test.mts pins the two together.)
                       (request.resource.data.get('marketingConsent', false) != true ||
                         (request.resource.data.get('marketingConsentAt', null) == request.time &&
                          request.resource.data.get('marketingConsentSource', '') == 'waitlist')) &&
                       // 3. And proof without an opt-in is equally malformed —
                       //    it would read in the CRM as evidence of a consent
                       //    nobody gave.
                       (!('marketingConsentAt' in request.resource.data) ||
                         request.resource.data.get('marketingConsent', false) == true) &&
                       (!('marketingConsentSource' in request.resource.data) ||
                         request.resource.data.get('marketingConsent', false) == true);
      allow read, update, delete: if false;
    }

    match /meta/waitlist {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
                      request.resource.data.count is number &&
                      request.resource.data.count >= 0 &&
                      request.resource.data.count < 1000000;
    }

    // ===============================================================
    // Waitlist referrals — the public counter collection
    // ===============================================================
    //
    // referrals/{code} is the ONLY readable half of the waitlist. It carries
    // no PII by construction: a random share code, the public operator id
    // ("HA-052"), and three numbers. Attribution (who referred whom) stays on
    // the create-only application document, where it is never client-readable.
    //
    // World-readable because a signed-out visitor arriving on ?ref=CODE has to
    // be able to resolve it, and because the share screen renders the owner's
    // standing from this one document — one read, no query, no fan-out.
    //
    // The whole position model is arithmetic on this doc: pos is always
    // basePos - credited * REFERRAL_JUMP, floored at 1. Mirror any change here
    // in app/lib/referral.ts (REFERRAL_MAX / REFERRAL_JUMP) — the two are a
    // pair, and the update rule below is what actually enforces the cap.
    //
    // Writes are unauthenticated (the waitlist is public, same posture as the
    // meta/waitlist counter above), so the rule bounds what a write can do
    // rather than who may do it: create must start at zero, update may only
    // ever add ONE confirmed referral, may never push credited past the cap,
    // and must recompute pos exactly. Identity fields are frozen after create.
    // A determined caller can still replay the +1 — that is the same
    // client-trusted v1 posture as the queue counter, not an oversight.
    //
    // STAFF LEAD-SOURCE CODES live in this same collection and are minted ONLY
    // by the Admin SDK (scripts/staff-referrals.js), which bypasses these
    // rules. Two properties make that safe rather than a hole:
    //   • The create rule below accepts an EXACT field list that does not
    //     include `kind`, so no client can mint a document claiming to be a
    //     staff code — the marker is unforgeable from a browser.
    //   • The update rule only ever touches confirmed/credited/pos/updatedAt,
    //     so a client can credit a staff code (which is the whole point) but
    //     cannot strip or rewrite the marker, and cannot delete the counter.
    // A staff counter carries basePos == 1, the fixed point of the position
    // arithmetic below: referralPos(1, credited) == 1 for every credited, so
    // the shared update rule leaves its position alone without needing a branch
    // for it. See STAFF_COUNTER_KIND in app/lib/referral.ts.

    function referralCounted(credited) {
      // min(credited, REFERRAL_MAX) — rules have no min().
      return credited < 5 ? credited : 5;
    }

    function referralPos(basePos, credited) {
      // max(1, basePos - credited * REFERRAL_JUMP) — rules have no max().
      return basePos - referralCounted(credited) * 10 > 1
        ? basePos - referralCounted(credited) * 10
        : 1;
    }

    match /referrals/{code} {
      allow read: if true;

      allow create: if code.matches('^[ABCDEFGHJKMNPQRSTVWXYZ23456789]{6}$') &&
                       request.resource.data.keys().hasOnly(
                         ['code', 'opId', 'basePos', 'confirmed', 'credited',
                          'pos', 'createdAt', 'updatedAt']) &&
                       request.resource.data.keys().hasAll(
                         ['code', 'opId', 'basePos', 'confirmed', 'credited',
                          'pos', 'createdAt', 'updatedAt']) &&
                       request.resource.data.code == code &&
                       validString(request.resource.data.opId, 1, 20) &&
                       request.resource.data.basePos is int &&
                       request.resource.data.basePos > 0 &&
                       request.resource.data.basePos < 1000000 &&
                       request.resource.data.confirmed == 0 &&
                       request.resource.data.credited == 0 &&
                       request.resource.data.pos == request.resource.data.basePos &&
                       request.resource.data.createdAt is timestamp &&
                       request.resource.data.updatedAt is timestamp;

      // One confirmed referral at a time, and nothing else moves.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['confirmed', 'credited', 'pos', 'updatedAt']) &&
                       request.resource.data.confirmed == resource.data.confirmed + 1 &&
                       request.resource.data.confirmed < 1000000 &&
                       request.resource.data.credited ==
                         referralCounted(resource.data.credited + 1) &&
                       request.resource.data.pos ==
                         referralPos(resource.data.basePos, request.resource.data.credited) &&
                       request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // ===============================================================
    // Profiles
    // ===============================================================

    function isValidProfile(data) {
      return hasOnlyAllowedFields(['uid', 'name', 'ageBand', 'country', 'timezone',
               'headline', 'building', 'stage', 'domains', 'skills',
               'proofUrl', 'proofNote', 'hours', 'bio', 'links',
               'consentStatus', 'consentEmailSentAt', 'plan', 'role',
               'streak', 'streakFreezes', 'lastActiveDay', 'lastBuildLogDay',
               'enrolledWorkshops',
               'createdAt', 'updatedAt',
               // Legacy fields: tolerated on docs that still carry them so a
               // merge-write of an old profile keeps validating (an update is
               // validated as the whole merged doc, not the delta). Nothing
               // reads them. pendingApplications joined when squads went.
               'xp', 'attendedWorkshops', 'lastRitualWeek', 'pendingApplications']) &&
             hasRequiredFields(['uid', 'name', 'ageBand', 'country', 'timezone',
               'headline', 'building', 'stage', 'domains', 'skills',
               'consentStatus', 'plan', 'role',
               'streak', 'streakFreezes', 'lastActiveDay', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             validString(data.name, 1, 80) &&
             data.ageBand in ['13-15', '16-17', '18+'] &&
             validString(data.country, 1, 60) &&
             validString(data.timezone, 1, 60) &&
             validString(data.headline, 0, 90) &&
             validString(data.building, 0, 300) &&
             data.stage in ['idea', 'building', 'launched', 'revenue'] &&
             validStringList(data.domains, 9) && data.domains.size() >= 1 &&
             validStringList(data.skills, 7) && data.skills.size() >= 1 &&
             (!('proofUrl' in data) || validString(data.proofUrl, 0, 300)) &&
             (!('proofNote' in data) || validString(data.proofNote, 0, 200)) &&
             // Weekly hours moved to per-application; kept optional here so
             // legacy profile docs that still carry it continue to validate.
             (!('hours' in data) || data.hours in ['<3', '3-5', '5-10', '10+']) &&
             (!('bio' in data) || validString(data.bio, 0, 300)) &&
             (!('links' in data) || (data.links is map && data.links.keys().hasOnly(['github', 'linkedin', 'site']))) &&
             data.consentStatus in ['none', 'pending', 'granted'] &&
             (!('consentEmailSentAt' in data) || data.consentEmailSentAt is timestamp) &&
             data.plan in ['free', 'pro'] &&
             data.role in ['operator', 'mentor'] &&
             data.streak is number && data.streak >= 0 && data.streak <= 100000 &&
             data.streakFreezes is number && data.streakFreezes >= 0 && data.streakFreezes <= 3 &&
             validString(data.lastActiveDay, 10, 10) &&
             (!('lastBuildLogDay' in data) || validString(data.lastBuildLogDay, 0, 10)) &&
             (!('enrolledWorkshops' in data) || validStringList(data.enrolledWorkshops, 100)) &&
             (!('pendingApplications' in data) || validStringList(data.pendingApplications, 3));
    }

    // Mentors (trusted staff) grant parental consent in-app — the only
    // cross-user profile write. Scoped to flipping consentStatus to
    // 'granted'; role and plan grants stay server-side (admin CLI tooling
    // and the mentor-invite redemption route).
    function isConsentGrant() {
      return isMentor() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consentStatus', 'updatedAt']) &&
             request.resource.data.consentStatus == 'granted';
    }

    match /profiles/{userId} {
      allow read: if isAuthenticated();
      // Clients always start as free-tier operators; admin tooling
      // (which bypasses rules) grants mentor role / pro plan.
      //
      // TEMPORARY — founding-batch access gate: the caller's email must also be
      // on the approvedMembers allowlist. This is what stops a stranger who
      // reached Firebase Auth by some other route from minting an account once
      // the platform is live in production. It does NOT affect the mentor
      // paths: both /api/mentor/redeem and /api/access/mentor-profile write
      // through the Admin SDK, which bypasses rules entirely.
      // Drop the isApprovedMember() clause when the batch ends.
      allow create: if isOwner(userId) && isValidProfile(request.resource.data) &&
                       request.resource.data.role == 'operator' &&
                       request.resource.data.plan == 'free' &&
                       // A new account starts with at most a 1-day streak and
                       // nothing banked; every later change is server-written.
                       request.resource.data.streak <= 1 &&
                       request.resource.data.streakFreezes == 0 &&
                       request.resource.data.get('lastBuildLogDay', '') == '' &&
                       isApprovedMember();
      // consentStatus + consentEmailSentAt are immutable on a self-update: a
      // pending minor must NOT be able to grant their own consent. Consent is
      // flipped only by a mentor (isConsentGrant) or the server (Admin SDK,
      // which bypasses rules) via the parent-approval link.
      // The STREAK is immutable on a self-update too: streak, streakFreezes,
      // lastActiveDay and lastBuildLogDay are written only by the server
      // (/api/build-log, /api/submissions — app/lib/streakServer.ts).
      allow update: if (isOwner(userId) && isValidProfile(request.resource.data) &&
                        areImmutableFieldsUnchanged(['uid', 'createdAt', 'role', 'plan',
                          'consentStatus', 'consentEmailSentAt',
                          'streak', 'streakFreezes', 'lastActiveDay', 'lastBuildLogDay'])) ||
                       isConsentGrant();
      allow delete: if false;
    }

    // ===============================================================
    // Private profiles — owner-only, both directions
    // ===============================================================

    match /privateProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        hasOnlyAllowedFields(['uid', 'firstName', 'lastName', 'dob', 'city', 'parentEmail', 'createdAt', 'updatedAt']) &&
        request.resource.data.uid == request.auth.uid &&
        validString(request.resource.data.firstName, 1, 60) &&
        validString(request.resource.data.lastName, 1, 60) &&
        validString(request.resource.data.dob, 10, 10) &&
        (!('city' in request.resource.data) || validString(request.resource.data.city, 0, 80)) &&
        (!('parentEmail' in request.resource.data) || validString(request.resource.data.parentEmail, 0, 254));
      allow delete: if false;
    }


    // ===============================================================
    // The season — ONE shared track, and the proof against it. Both are
    // server-written (app/api/season, app/api/submissions/**, Admin SDK),
    // the same posture as workshops: every mentor edits the same document,
    // so saves need a transaction with a stale-write check; the milestone
    // list is the authorization input for submissions and rules can't
    // validate list elements; and removing a milestone that has proof has
    // to be refused, which needs a query.
    // ===============================================================

    match /seasons/{seasonId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      // Doc id is `{uid}__{milestoneId}`: one row per operator per milestone.
      //
      // Read scope: the author always; any mentor (the review queue); and,
      // when the milestone's verifier was 'open' AT SUBMIT TIME, every
      // signed-in user. `verifier` is stamped server-side from the milestone,
      // which is what makes it trustworthy here — and it's a snapshot, so a
      // milestone later flipped mentor→open never exposes proof made
      // privately. A LIST QUERY IS ALL-OR-NOTHING: the public wall must
      // filter where('verifier','==','open'), your own rows where('uid',
      // '==', you); an unfiltered list is denied for anyone but a mentor.
      // isMentor() costs a get(), so it is evaluated last.
      match /submissions/{subId} {
        allow read: if isAuthenticated() &&
                       (resource.data.uid == request.auth.uid ||
                        resource.data.get('verifier', 'mentor') == 'open' ||
                        isMentor());
        allow create, update, delete: if false;
      }
    }

    // ===============================================================
    // Build log — the season feed. Posting is SERVER-ONLY (POST
    // /api/build-log): it is a streak action, and the streak is computed and
    // written alongside it by the Admin SDK. Everyone reads; the author may
    // delete their own line.
    // ===============================================================

    match /buildLogs/{logId} {
      allow read: if isAuthenticated();
      allow create, update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    // ===============================================================
    // Workshops — read by every signed-in user, written only by the server.
    // Authoring (mentor), enrolling and leaving (anyone) all run through
    // app/api/workshops/** with the Admin SDK, which bypasses these rules:
    // the seat is claimed in a server transaction, and the host mentor's
    // Google Calendar event is kept in step with the roster.
    // ===============================================================

    match /workshops/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // ===============================================================
    // Google tokens — server-only. A mentor's encrypted Google refresh
    // token, read and written exclusively by app/lib/googleCalendar.ts.
    // ===============================================================

    match /googleTokens/{uid} {
      allow read, write: if false;
    }

    // ===============================================================
    // Consent tokens — server-only. Minted, read, and consumed exclusively
    // by the Admin SDK (Route Handlers under app/api/consent/**), which
    // bypasses these rules. No client may ever read or write them: the token
    // hash must never be exposed, and grants must stay server-authoritative.
    // ===============================================================

    match /consentTokens/{tokenHash} {
      allow read, write: if false;
    }

    // ===============================================================
    // Mentor invites — server-only, same posture as consentTokens.
    // Minted by staff (scripts/mentor-invite.js, CLI OAuth) and consumed
    // exclusively by the Admin SDK (/api/mentor/redeem). The doc id is the
    // SHA-256 hash of the invite code, so even a hypothetical read could
    // never leak a usable code — but no client may read or write anyway:
    // becoming a mentor must stay server-authoritative.
    // ===============================================================

    match /mentorInvites/{codeHash} {
      allow read, write: if false;
    }

    // ===============================================================
    // Staff referral codes — server-only, same posture as mentorInvites.
    // The private half of the staff lead-source codes: slug → code, plus the
    // person's name and Slack id. Written by scripts/staff-referrals.js
    // (Admin SDK, bypasses rules) and read by nothing else. Its only job is
    // idempotency, so nothing in the product ever needs it at request time.
    // The PUBLIC half — referrals/{code} — carries neither a name nor a Slack
    // id precisely so this document can stay closed. See app/lib/staffReferrals.ts.
    // ===============================================================

    match /staffReferralCodes/{slug} {
      allow read, write: if false;
    }

    // ===============================================================
    // TEMPORARY — founding-batch access gate.
    // Approved members — server-only, same posture as consentTokens and
    // mentorInvites. Staff writes these by hand in the Firebase Console or
    // with scripts/approve.js (CLI OAuth, bypasses rules); the app reads them
    // only through the Admin SDK in app/api/access/**. No client may read the
    // list (it is a roster of real people's emails) or write it (that would be
    // self-approval). isApprovedMember() above still resolves against it —
    // exists() is evaluated by the rules engine, not by the client.
    // Delete this block with the rest of the gate; see app/lib/accessGate.ts.
    // ===============================================================

    match /approvedMembers/{email} {
      allow read, write: if false;
    }
  }
}
