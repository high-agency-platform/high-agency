    "test:rules": "firebase emulators:exec --only firestore --project highagency-rules-test \"node --test tests/rules.test.mjs\"",
    "test:consent": "firebase emulators:exec --only firestore --project highagency-62e67 \"tsx --test tests/consent.test.mts\"",
